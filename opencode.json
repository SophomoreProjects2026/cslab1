{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "cooper-ulab": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cooper uLab",
      "options": {
        "baseURL": "https://chatterbox.ee.cooper.edu/api/v1",
        "apiKey": "{env:CHATTERBOX_KEY}"
      },
      "models": {
        "nvidia/Gemma-4-26B-A4B-NVFP4": {
          "name": "Gemma Stone",
          "limit": { "context": 131172, "output": 8192 }
        }
      }
    }
  }
}
